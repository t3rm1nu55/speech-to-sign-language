# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Processing Mode: "on-device", "cloud", "hybrid"
PROCESSING_MODE=hybrid

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sign_language_db

# For on-device deployment with SQLite:
# DATABASE_URL=sqlite:///./sign_language.db

# ============================================
# Redis Cache
# ============================================
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL=3600

# ============================================
# Speech Recognition Configuration
# ============================================

# Primary Provider: whisper, google, azure, aws
SPEECH_PROVIDER=whisper

# Whisper (On-Device) Settings
WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
WHISPER_DEVICE=cpu  # Options: cpu, cuda

# Google Cloud Speech
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Azure Cognitive Services Speech
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# AWS Transcribe
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ============================================
# Sign Language Settings
# ============================================
DEFAULT_SIGN_LANGUAGE=ASL  # Options: ASL, BSL, ISL, LSF

# Translation
USE_NLP_TRANSLATION=true
TRANSLATION_MODEL=rule-based  # Options: rule-based, ml-based

# Animation
ANIMATION_PROVIDER=avatar  # Options: avatar, video, hybrid
AVATAR_QUALITY=medium  # Options: low, medium, high
ANIMATION_OUTPUT_FORMAT=mp4  # Options: mp4, webm, gif
VIDEO_LIBRARY_PATH=./data/sign_videos

# ============================================
# Storage Configuration
# ============================================
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# ============================================
# Security Settings
# ============================================
API_KEY_ENABLED=false
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Performance Settings
# ============================================
ENABLE_ASYNC_PROCESSING=true
MAX_WORKERS=4

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=./logs/app.log

# ============================================
# CORS Settings (Add your frontend URLs)
# ============================================
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
